APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila
APP_KEY=replace-with-a-random-64-character-secret
# Local default: no MySQL account is required. Run `php scripts/install.php`
# after copying this file to .env. Relative SQLite paths resolve from the
# project directory, including when PHP is started from XAMPP on Windows.
DB_DSN=sqlite:storage/mypro.sqlite
DB_USERNAME=
DB_PASSWORD=
# Production MySQL/MariaDB example (replace all values before using it):
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=mypro;charset=utf8mb4
# DB_USERNAME=mypro
# DB_PASSWORD=use-a-strong-database-password
ADMIN_NAME=MyPro Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAIL_FROM_ADDRESS=sales.myprosolinc@gmail.com
INQUIRY_NOTIFICATION_EMAIL=sales.myprosolinc@gmail.com
SESSION_SECURE=false
CONTENT_CACHE_TTL=300
